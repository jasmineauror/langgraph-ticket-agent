# Copy to .streamlit/secrets.toml (gitignored) for local runs, and paste the
# same contents into Streamlit Community Cloud > Advanced settings > Secrets.

# Shared passcode for the demo. A speed bump over HTTPS, not authentication.
APP_PASSCODE = "change-me"

# groq is strongly preferred for a deployed demo: 1,000 requests/day/model
# against Gemini's 20/day/model, with the same strict schema-constrained
# decoding. One eval run is ~21 requests.
TRIAGE_LLM = "groq"

GROQ_API_KEY = "gsk_..."
GEMINI_API_KEY = ""

# Optional. Seconds between outbound model calls. Guards a per-minute quota;
# a per-DAY cap is unaffected by pacing.
# TRIAGE_MIN_INTERVAL = "1.5"
